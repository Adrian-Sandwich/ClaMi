<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  UI MAGI (magi_ui.py): interfaz web del sistema de decisiones.

  Server HTTP stdlib en 127.0.0.1:8051. Sirve la interfaz y empuja estado
  por SSE alimentado por LISTEN/NOTIFY — se entera de cada voto al instante.
  Se instala con launchd/install.sh (glob com.adrianmedina.*.plist).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.adrianmedina.magi-ui</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/adrianmedina/src/ClaMi/debate-mcp/.venv/bin/python</string>
        <string>/Users/adrianmedina/src/ClaMi/debate-mcp/magi_ui.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/adrianmedina/src/ClaMi/debate-mcp</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/adrianmedina/src/ClaMi/debate-mcp/logs/magi_ui.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/adrianmedina/src/ClaMi/debate-mcp/logs/magi_ui.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin:/Users/adrianmedina/.local/bin</string>
    </dict>
</dict>
</plist>
