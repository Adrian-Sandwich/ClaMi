<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daemon relay del tablero de debate.

  El plist vivía sólo en ~/Library/LaunchAgents, sin copia en el repo: la
  definición de cómo corre el sistema no estaba versionada en ningún lado.
  Ahora está acá y se instala con `launchd/install.sh`.

  KeepAlive reinicia el proceso si muere, pero no distingue "vivo" de "vivo y
  roto" — de eso se ocupa el heartbeat que escribe el relay y que revisa
  com.adrianmedina.clami-healthcheck.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.adrianmedina.debate-relay</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/adrianmedina/src/ClaMi/debate-mcp/.venv/bin/python</string>
        <string>/Users/adrianmedina/src/ClaMi/debate-mcp/relay.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/adrianmedina/src/ClaMi/debate-mcp</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/adrianmedina/src/ClaMi/debate-mcp/logs/daemon.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/adrianmedina/src/ClaMi/debate-mcp/logs/daemon.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin:/Users/adrianmedina/.local/bin</string>
    </dict>
</dict>
</plist>
